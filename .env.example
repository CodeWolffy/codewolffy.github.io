# Keystatic CMS — 生产环境必须配置以下环境变量
# 本地开发无需此文件，Keystatic 默认使用本地文件系统存储

# GitHub OAuth App 凭据
# 在 https://github.com/settings/developers 创建 OAuth App：
#   Homepage URL: https://your-domain.pages.dev
#   Authorization callback URL: https://your-domain.pages.dev/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Keystatic 会话加密密钥（32字节 base64 字符串）
# 生成命令: openssl rand -base64 32
KEYSTATIC_SECRET=
