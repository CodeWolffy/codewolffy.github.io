# Keystatic CMS — Cloudflare Pages 生产环境必须配置以下环境变量
# 本地开发默认使用本地文件系统存储。
# GitHub Pages 是纯静态托管，不支持 Keystatic 后台/API；Cloudflare Pages 通过 SSR/API routes 支持。

# GitHub App 凭据
# 可先在本地访问 /keystatic 按提示创建 GitHub App，再把生成的值复制到 Cloudflare Pages 环境变量。
# GitHub App callback URL:
#   https://your-domain.pages.dev/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Keystatic 会话加密密钥，至少 32 字符。
# 生成命令: openssl rand -base64 32
KEYSTATIC_SECRET=

# Astro 客户端可见的 GitHub App slug，用于 Keystatic GitHub 登录入口。
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
