{
  "name": "blog",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host",
    "build": "npm run sync-content && npm run check:mermaid && astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "sync-content": "node --import tsx scripts/sync-content.js",
    "clean-content": "node --import tsx scripts/clean-content.js",
    "clean-content:dry-run": "node --import tsx scripts/clean-content.js --dry-run",
    "check:mermaid": "node scripts/check-mermaid-regression.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro,.mjs",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro,.mjs --fix",
    "typecheck": "astro check && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@giscus/react": "^3.1.0",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.48",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.12.2",
    "pagefind": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.26.1"
  }
}
