---
interface Props {
  type?: 'post' | 'category' | 'tag' | 'project' | 'friend';
  title?: string;
  description?: string;
  class?: string;
}

const { type = 'post', title, description, class: className } = Astro.props;

const defaultMessages = {
  post: { icon: '📝', title: '暂无文章', description: '灵感还在路上，后续内容会在这里汇集。' },
  category: {
    icon: '📁',
    title: '暂无分类',
    description: '等文章积累起来后，分类索引会自动呈现。',
  },
  tag: {
    icon: '🏷️',
    title: '暂无标签',
    description: '当前还没有可浏览的标签，先去看看其他内容吧。',
  },
  project: {
    icon: '🚀',
    title: '暂无项目',
    description: '项目作品集正在整理中，稍后会展示更多实践成果。',
  },
  friend: { icon: '🤝', title: '暂无友链', description: '友链列表暂时为空，欢迎后续交换链接。' },
};

const message = defaultMessages[type];
---

<div
  class:list={[
    'group relative isolate flex min-h-64 flex-col items-center justify-center overflow-hidden rounded-2xl border border-dashed border-border/70 bg-card/80 px-6 py-16 text-center shadow-sm',
    className,
  ]}
>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-primary/[0.06] via-transparent to-muted/40"
  >
  </div>
  <div
    class="absolute left-1/2 top-0 -z-10 h-32 w-56 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/10 blur-3xl transition-opacity duration-500 group-hover:opacity-80"
  >
  </div>

  <div
    class="mb-5 flex h-20 w-20 items-center justify-center rounded-2xl border border-border/70 bg-background/80 text-5xl shadow-sm transition-transform duration-300 group-hover:-translate-y-1"
  >
    <span class="select-none" aria-hidden="true">{message.icon}</span>
  </div>

  <h3 class="text-xl font-black tracking-tight text-foreground sm:text-2xl">
    {title || message.title}
  </h3>
  <p class="mt-2 max-w-sm text-sm leading-6 text-muted-foreground">
    {description || message.description}
  </p>
  <div class="mt-6">
    <slot />
  </div>
</div>
