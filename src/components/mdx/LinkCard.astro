---
// 链接卡片组件
// 在文章中以卡片形式展示外部链接

interface Props {
  title: string;
  url: string;
  description?: string;
}

const { title, url, description } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="my-4 block rounded-lg border border-border bg-card p-4 hover:border-primary/50 hover:bg-secondary/30 transition-all group"
>
  <div class="flex items-start gap-3">
    <div class="shrink-0 mt-1 text-muted-foreground group-hover:text-primary transition-colors">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
    </div>
    <div class="min-w-0">
      <div class="font-medium text-foreground group-hover:text-primary transition-colors">
        {title}
      </div>
      {description && <div class="text-sm text-muted-foreground mt-1">{description}</div>}
      <div class="text-xs text-muted-foreground/70 mt-2 truncate">{url}</div>
    </div>
  </div>
</a>
