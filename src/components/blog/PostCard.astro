---
import type { CollectionEntry } from 'astro:content';

import { getBlogPostPath } from '@/utils/content-paths';

interface Props {
  post: CollectionEntry<'blog'>;
  mainTagLabel?: string;
  index?: number;
  readingTime?: number;
}

const { post, mainTagLabel, index = 0, readingTime } = Astro.props;
const postPath = getBlogPostPath(post);
---

<article
  class="group relative flex h-full flex-col space-y-2 rounded-2xl p-3.5 bg-card border border-border/60 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/35 hover:shadow-lg animate-slide-up"
  style={`animation-delay: ${index * 50}ms;`}
>
  {
    (post.data.coverImage || post.data.heroImage) && (
      <div class="aspect-video overflow-hidden rounded-xl bg-muted relative">
        <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10" />
        <img
          src={post.data.coverImage || post.data.heroImage}
          alt={post.data.title}
          width={804}
          height={452}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-all duration-500 group-hover:scale-110"
        />
      </div>
    )
  }
  <div class="flex-1 space-y-1 relative z-10">
    <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-muted-foreground">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'numeric',
            day: 'numeric',
          })
        }
      </time>
      {
        readingTime && (
          <>
            <span>•</span>
            <span>{readingTime} 分钟</span>
          </>
        )
      }
      {
        mainTagLabel && (
          <>
            <span>•</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-primary/10 text-primary">
              {mainTagLabel}
            </span>
          </>
        )
      }
    </div>
    <h3
      class="text-base font-bold leading-tight group-hover:text-primary transition-colors duration-300 line-clamp-2"
    >
      <a href={postPath}>
        {post.data.title}
      </a>
    </h3>
    <p class="text-muted-foreground line-clamp-2 text-xs leading-relaxed">
      {post.data.description}
    </p>
  </div>
  <a href={postPath} class="absolute inset-0 z-20">
    <span class="sr-only">阅读 {post.data.title}</span>
  </a>
</article>
