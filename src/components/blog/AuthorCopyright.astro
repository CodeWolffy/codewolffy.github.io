---
import { getEntry } from 'astro:content';
import ResponsiveAvatar from '@/components/ui/ResponsiveAvatar.astro';
import { buttonVariants } from '@/components/ui/button';
import { getIconComponent } from '@/lib/icons';

interface Props {
  authorName: string;
  githubUrl: string;
  rssUrl: string;
  licenseName: string;
  licenseUrl: string;
  noticePrefix: string;
  noticeSuffix: string;
}

const { authorName, githubUrl, rssUrl, licenseName, licenseUrl, noticePrefix, noticeSuffix } =
  Astro.props;

const aboutPage = await getEntry('pages', 'about');
const about = aboutPage?.data;
const displayName = about?.name ? `${authorName} (${about.name})` : authorName;
const tagline = about?.tagline || 'StackOverflow 野生代言人';
const subtitle = about?.subtitle || '分享 Java、Spring、数据库与分布式系统的源码剖析与实践记录。';
const GithubIcon = getIconComponent('github');
const RssIcon = getIconComponent('rss');
---

<section
  aria-label="作者与版权信息"
  class="my-6 rounded-2xl border border-border/70 bg-card/70 p-4 sm:p-5 shadow-xs space-y-4"
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3.5 min-w-0">
      <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full border border-border bg-muted">
        <ResponsiveAvatar
          src={about?.avatar || '/images/pages/avatar.jpg'}
          alt={displayName}
          sizes="48px"
          width={48}
          height={48}
          class="h-full w-full object-cover"
        />
      </div>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
          <span class="font-bold text-base text-foreground">{displayName}</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary font-medium">
            {tagline}
          </span>
        </div>
        <p class="mt-1 text-xs sm:text-sm text-muted-foreground line-clamp-2">{subtitle}</p>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0 flex-wrap">
      <a
        href="/about/"
        class:list={[buttonVariants({ variant: 'outline', size: 'sm' }), 'rounded-full text-xs']}
      >
        关于作者
      </a>
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          buttonVariants({ variant: 'outline', size: 'sm' }),
          'rounded-full text-xs gap-1.5',
        ]}
      >
        <GithubIcon aria-hidden="true" width={14} height={14} />
        GitHub
      </a>
      <a
        href={rssUrl}
        class:list={[
          buttonVariants({ variant: 'ghost', size: 'sm' }),
          'rounded-full text-xs gap-1.5 text-muted-foreground hover:text-foreground',
        ]}
      >
        <RssIcon aria-hidden="true" width={13} height={13} />
        RSS
      </a>
    </div>
  </div>

  <div class="border-t border-border/60 pt-3 text-xs leading-relaxed text-muted-foreground">
    <span class="font-medium text-foreground/80">版权声明：</span>
    {noticePrefix}{' '}
    <a
      href={licenseUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-primary font-medium hover:underline underline-offset-2"
    >
      {licenseName}
    </a>{' '}
    {noticeSuffix}
  </div>
</section>
