---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="离线中 | 狼码纪" description="当前处于离线状态，请检查网络连接。">
  <div
    class="container mx-auto flex min-h-[60vh] flex-col items-center justify-center px-4 text-center"
  >
    <div class="mb-6 text-6xl">📡</div>
    <h1 class="mb-4 text-3xl font-bold tracking-tight lg:text-5xl">当前处于离线状态</h1>
    <p class="mb-8 max-w-md text-lg text-muted-foreground">
      网络连接似乎中断了。你可以尝试刷新页面，或先浏览已缓存的内容。
    </p>
    <button
      onclick="window.location.reload()"
      class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90"
    >
      刷新页面
    </button>
  </div>
</BaseLayout>
