---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { ArrowRight } from 'lucide-react';
import PostCard from '@/components/blog/PostCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { getReadingTimeMinutes } from '@/utils/reading-time';
import { getSiteSettings } from '@/utils/site-settings';
import {
  countPostCategories,
  countPostTags,
  createSeriesSummaries,
  createTaxonomyNameMap,
  getPublicBlogPostsSorted,
} from '@/utils/posts';

const settings = await getSiteSettings();
const homeUi = settings.ui.home;

const posts = (await getPublicBlogPostsSorted()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allCategories = await getCollection('categories');
const allTags = await getCollection('tags');
const allSeries = await getCollection('series');

const categoryMap = createTaxonomyNameMap(allCategories);
const tagMap = createTaxonomyNameMap(allTags);

const latestPosts = posts.slice(0, 15);

const sortedTags = countPostTags(posts, tagMap);
const sortedCategories = countPostCategories(posts, categoryMap);

// 精选专栏数据 (取文章数大于 0 的前 3 个)
const seriesSummaries = createSeriesSummaries(allSeries, posts);
const featuredSeries = seriesSummaries
  .filter((summary) => summary.postCount > 0)
  .slice(0, 3)
  .map((summary) => ({
    id: summary.series.id,
    name: summary.series.data.name,
    description: summary.series.data.description,
    postCount: summary.postCount,
  }));

// Limit items for homepage (Preview)
const topCategories = sortedCategories.slice(0, 4);
const topTags = sortedTags.slice(0, 8);

// 首页结构化数据：WebSite + 站内搜索（SearchAction 指向 /?q=，由 Search 组件接管）
const siteUrl = (Astro.site ?? new URL(settings.urls.primary)).href.replace(/\/$/, '');
const externalSocials = settings.socials
  .map((s) => s.href)
  .filter((href) => /^https?:\/\//.test(href));
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.name,
  url: `${siteUrl}/`,
  description: settings.description,
  inLanguage: 'zh-CN',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
  publisher: {
    '@type': 'Person',
    name: settings.author.name,
    url: `${siteUrl}/`,
    ...(externalSocials.length > 0 ? { sameAs: externalSocials } : {}),
  },
};
---

<BaseLayout title={settings.name}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <!-- Hero Section -->

  <!-- Main Content Grid -->
  <section class="container mx-auto pt-0 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8">
      <!-- Mobile Sidebar Content (Moved to bottom) -->

      <!-- Left Column: Posts List -->
      <div class="lg:col-span-8 space-y-4">
        <!-- Hero Text Block -->
        <div class="space-y-3 text-center md:text-left max-w-3xl mb-4 pt-1">
          <div class="space-y-2">
            <div
              class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-primary/20 bg-primary/10 text-primary hover:bg-primary/20"
            >
              {homeUi.badge}
            </div>
            <h1
              class="text-3xl font-extrabold tracking-tight sm:text-4xl xl:text-5xl pb-1 bg-clip-text text-transparent bg-gradient-to-r from-foreground via-foreground to-foreground/75"
            >
              {homeUi.taglineFallback}
            </h1>
            <p
              class="mx-auto md:mx-0 max-w-[620px] text-muted-foreground text-base md:text-lg leading-relaxed"
            >
              {homeUi.subtitleFallback}
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start pt-1">
            <a
              href="#latest-posts"
              class:list={[
                buttonVariants({ size: 'default', variant: 'outline' }),
                'rounded-full px-6 bg-background hover:bg-muted text-foreground shadow-sm border transition-all',
              ]}
            >
              {homeUi.readButton}
              <ArrowRight className="ml-2 w-4 h-4" />
            </a>
            <a
              href="/archives/"
              class:list={[
                buttonVariants({ size: 'default' }),
                'rounded-full px-6 bg-foreground text-background hover:bg-foreground/90 shadow-md transition-all',
              ]}
            >
              {homeUi.archivesButton}
            </a>
          </div>
        </div>

        <div
          id="latest-posts"
          class="flex items-center justify-between border-b pb-2 mb-2 scroll-mt-20"
        >
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight flex items-center gap-2">
            {homeUi.latestTitle}
          </h2>
          <a
            href="/archives/"
            class="text-xs sm:text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-1"
          >
            {homeUi.viewAllText}
            <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            latestPosts.map((post, index) => (
              <PostCard
                post={post}
                index={index}
                featured={index === 0}
                categoryLabel={
                  post.data.category
                    ? categoryMap.get(post.data.category) || post.data.category
                    : undefined
                }
                mainTagLabel={
                  post.data.tags && post.data.tags.length > 0
                    ? tagMap.get(post.data.tags[0]) || post.data.tags[0]
                    : undefined
                }
                readingTime={getReadingTimeMinutes(post.body || '')}
              />
            ))
          }
        </div>

        {posts.length === 0 && <EmptyState type="post" class="w-full" />}
      </div>

      <!-- Mobile Sidebar Content (Moved to bottom) -->
      <div class="lg:hidden w-full mt-2">
        <Sidebar
          tags={topTags}
          categories={topCategories}
          featuredSeries={featuredSeries}
          className="w-full"
        />
      </div>

      <!-- Right Column: Sidebar (独立分开滑动) -->
      <div class="hidden lg:block lg:col-span-4 pl-4">
        <div
          class="sticky top-20 max-h-[calc(100vh-5.5rem)] overflow-y-auto overscroll-contain pr-1 pb-8 sidebar-scrollbar"
        >
          <Sidebar tags={topTags} categories={topCategories} featuredSeries={featuredSeries} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
