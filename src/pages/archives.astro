---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { getBlogPostPath } from '@/utils/content-paths';
import {
  countPostCategories,
  countPostTags,
  createTaxonomyNameMap,
  getPublicBlogPostsSorted,
} from '@/utils/posts';

const allPosts = await getPublicBlogPostsSorted();

const allTags = await getCollection('tags');
const tagMap = createTaxonomyNameMap(allTags);
const sortedTags = countPostTags(allPosts, tagMap);
const topTags = sortedTags.slice(0, 8);

const allCategories = await getCollection('categories');
const categoryMap = createTaxonomyNameMap(allCategories);
const sortedCategories = countPostCategories(allPosts, categoryMap);
const topCategories = sortedCategories.slice(0, 4);

const formatTwoDigits = (value: number) => value.toString().padStart(2, '0');
const formatShortDate = (date: Date) =>
  `${formatTwoDigits(date.getMonth() + 1)}-${formatTwoDigits(date.getDate())}`;
const formatReadableDate = (date: Date) =>
  `${date.getFullYear()}-${formatTwoDigits(date.getMonth() + 1)}-${formatTwoDigits(date.getDate())}`;

const newestPost = allPosts[0];
const oldestPost = allPosts.at(-1);
const newestYear = newestPost?.data.pubDate.getFullYear();
const oldestYear = oldestPost?.data.pubDate.getFullYear();
const yearRangeLabel = newestYear
  ? newestYear === oldestYear
    ? `${newestYear}`
    : `${oldestYear} - ${newestYear}`
  : '暂无';
const latestDateLabel = newestPost ? formatReadableDate(newestPost.data.pubDate) : '暂无';

const groupedPosts = allPosts.reduce(
  (acc, post) => {
    const year = post.data.pubDate.getFullYear();

    let yearGroup = acc.find((item) => item.year === year);
    if (!yearGroup) {
      yearGroup = { year, posts: [] };
      acc.push(yearGroup);
    }

    yearGroup.posts.push(post);
    return acc;
  },
  [] as {
    year: number;
    posts: typeof allPosts;
  }[]
);

groupedPosts.sort((a, b) => b.year - a.year);

const archiveSummary = [
  { value: allPosts.length.toString(), label: '篇文章' },
  { value: yearRangeLabel, label: '写作跨度' },
  { value: latestDateLabel, label: '最近更新' },
  { value: `${sortedCategories.length}/${sortedTags.length}`, label: '分类/标签' },
];
---

<BaseLayout title="文章归档 | 狼码纪" description="按时间、分类和标签浏览所有文章">
  <section class="container mx-auto pt-0 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8">
      <div class="lg:col-span-8 space-y-4">
        <section class="rounded-xl border border-border/70 bg-card/80 px-4 py-5 shadow-sm sm:px-5">
          <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
            <div class="space-y-2">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">
                Archive Index
              </p>
              <div class="space-y-1.5">
                <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
                  写作归档
                </h1>
                <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
                  按时间保留写作痕迹，顺着年份快速回看文章脉络。
                </p>
              </div>
            </div>

            <div
              class="grid grid-cols-2 gap-x-6 gap-y-3 border-t border-border/60 pt-4 md:min-w-72 md:border-l md:border-t-0 md:pl-6 md:pt-0"
            >
              {
                archiveSummary.map((item) => (
                  <div class="min-w-0">
                    <p class="truncate text-xl font-black leading-none tracking-tight text-foreground sm:text-2xl">
                      {item.value}
                    </p>
                    <p class="mt-1.5 text-xs font-medium text-muted-foreground">{item.label}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        {
          allPosts.length === 0 ? (
            <EmptyState type="post" class="w-full" />
          ) : (
            <div class="space-y-10 rounded-xl border border-border/70 bg-card/80 p-4 shadow-sm sm:p-6">
              {groupedPosts.map((yearGroup) => (
                <section id={`year-${yearGroup.year}`} class="scroll-mt-24">
                  <div class="grid grid-cols-[4.75rem_1.75rem_minmax(0,1fr)] items-center gap-3 sm:grid-cols-[5.5rem_2rem_minmax(0,1fr)] sm:gap-4">
                    <h2 class="border-l-2 border-foreground pl-2 text-3xl font-black tracking-tight text-foreground sm:text-4xl">
                      {yearGroup.year}
                    </h2>
                    <div class="flex justify-center">
                      <span class="h-3.5 w-3.5 rounded-full border-2 border-primary bg-background" />
                    </div>
                    <p class="text-sm text-muted-foreground sm:text-base">
                      {yearGroup.posts.length} 篇文章
                    </p>
                  </div>

                  <div class="mt-4 space-y-0">
                    {yearGroup.posts.map((post, postIndex) => (
                      <article class="group/archive-row relative grid grid-cols-[4.75rem_1.75rem_minmax(0,1fr)] gap-3 rounded-xl transition-all duration-300 hover:bg-accent hover:shadow-sm sm:grid-cols-[5.5rem_2rem_minmax(0,1fr)] sm:gap-4">
                        <time
                          datetime={post.data.pubDate.toISOString()}
                          class="relative z-10 py-3 text-right font-mono text-sm text-muted-foreground transition-colors duration-300 group-hover/archive-row:text-foreground"
                        >
                          {formatShortDate(post.data.pubDate)}
                        </time>

                        <div class="relative flex justify-center">
                          <span
                            class:list={[
                              'absolute top-0 bottom-0 border-l border-dashed border-border transition-colors duration-300 group-hover/archive-row:border-primary/60',
                              postIndex === yearGroup.posts.length - 1 ? 'h-3.5' : '',
                            ]}
                          />
                          <span class="relative mt-[1.15rem] h-1.5 w-1.5 rounded-full bg-muted-foreground ring-4 ring-background transition-all duration-300 group-hover/archive-row:h-6 group-hover/archive-row:w-1.5 group-hover/archive-row:rounded-full group-hover/archive-row:bg-primary group-hover/archive-row:ring-accent" />
                        </div>

                        <a
                          href={getBlogPostPath(post)}
                          class="relative z-10 grid min-w-0 gap-2 py-3 pr-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline"
                        >
                          <h3 class="min-w-0 break-words text-base font-bold leading-snug tracking-tight text-foreground transition-all duration-300 group-hover/archive-row:translate-x-1 group-hover/archive-row:text-primary sm:text-lg">
                            {post.data.title}
                          </h3>

                          <div class="flex flex-wrap gap-2 text-sm text-muted-foreground/70 transition-colors duration-300 group-hover/archive-row:text-foreground/75 sm:justify-end">
                            {post.data.category && (
                              <span>
                                #{categoryMap.get(post.data.category) || post.data.category}
                              </span>
                            )}
                            {post.data.tags?.slice(0, 2).map((tagId) => (
                              <span>#{tagMap.get(tagId) || tagId}</span>
                            ))}
                          </div>
                        </a>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          )
        }
      </div>

      <div class="lg:hidden w-full mt-2">
        <Sidebar
          tags={topTags}
          categories={topCategories}
          years={groupedPosts.map((g) => ({ year: g.year, count: g.posts.length }))}
          className="w-full"
        />
      </div>

      <div class="hidden lg:block lg:col-span-4 pl-4">
        <div class="sticky top-24">
          <Sidebar
            tags={topTags}
            categories={topCategories}
            years={groupedPosts.map((g) => ({ year: g.year, count: g.posts.length }))}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
