---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getBlogPostPath, getSeriesPath } from '@/utils/content-paths';
import { getSiteSettings } from '@/utils/site-settings';
import {
  countPostCategories,
  countPostTags,
  createSeriesSummaries,
  createTaxonomyNameMap,
  getPostSeries,
  getPublicBlogPostsSorted,
} from '@/utils/posts';

const settings = await getSiteSettings();
const archivesUi = settings.ui.archives;

const allPosts = await getPublicBlogPostsSorted();

const allTags = await getCollection('tags');
const tagMap = createTaxonomyNameMap(allTags);
const sortedTags = countPostTags(allPosts, tagMap);
const topTags = sortedTags.slice(0, 8);

const allCategories = await getCollection('categories');
const categoryMap = createTaxonomyNameMap(allCategories);
const sortedCategories = countPostCategories(allPosts, categoryMap);
const topCategories = sortedCategories.slice(0, 4);

type SeriesEntry = CollectionEntry<'series'>;

const allSeries: SeriesEntry[] = await getCollection('series');
const seriesSummaries = createSeriesSummaries(allSeries, allPosts);
const seriesPostCounts = new Map(
  seriesSummaries.map((summary) => [summary.series.id, summary.postCount])
);
const featuredSeries = seriesSummaries
  .filter((summary) => summary.postCount > 0)
  .map((summary) => summary.series)
  .slice(0, 3);

const getSeriesStatusLabel = (status: string) =>
  status === 'completed' || status === '已完结' ? '已完结' : '连载中';

const formatTwoDigits = (value: number) => value.toString().padStart(2, '0');
const formatShortDate = (date: Date) =>
  `${formatTwoDigits(date.getMonth() + 1)}-${formatTwoDigits(date.getDate())}`;
const formatReadableDate = (date: Date) =>
  `${date.getFullYear()}-${formatTwoDigits(date.getMonth() + 1)}-${formatTwoDigits(date.getDate())}`;

const newestPost = allPosts[0];
const oldestPost = allPosts.at(-1);
const newestYear = newestPost?.data.pubDate.getFullYear();
const oldestYear = oldestPost?.data.pubDate.getFullYear();
const yearRangeLabel = newestYear
  ? newestYear === oldestYear
    ? `${newestYear}`
    : `${oldestYear} - ${newestYear}`
  : '暂无';
const latestDateLabel = newestPost ? formatReadableDate(newestPost.data.pubDate) : '暂无';

const groupedPosts = allPosts.reduce(
  (acc, post) => {
    const year = post.data.pubDate.getFullYear();

    let yearGroup = acc.find((item) => item.year === year);
    if (!yearGroup) {
      yearGroup = { year, posts: [] };
      acc.push(yearGroup);
    }

    yearGroup.posts.push(post);
    return acc;
  },
  [] as {
    year: number;
    posts: typeof allPosts;
  }[]
);

groupedPosts.sort((a, b) => b.year - a.year);

const archiveSummary = [
  { value: allPosts.length.toString(), label: '篇文章' },
  { value: yearRangeLabel, label: '写作跨度' },
  { value: latestDateLabel, label: '最近更新' },
  { value: `${sortedCategories.length}/${sortedTags.length}`, label: '分类/标签' },
];
---

<BaseLayout title={`文章归档 | ${settings.name}`} description="按时间、分类和标签浏览所有文章">
  <section class="container mx-auto pt-0 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8">
      <div class="lg:col-span-8 space-y-4">
        <section class="rounded-xl border border-border/70 bg-card/80 px-4 py-4 shadow-sm sm:px-5">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div class="space-y-2">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">
                {archivesUi.eyebrow}
              </p>
              <div class="space-y-1.5">
                <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
                  {archivesUi.title}
                </h1>
                <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
                  {archivesUi.description}
                </p>
              </div>
            </div>

            <div
              class="grid grid-cols-2 gap-x-5 gap-y-2.5 border-t border-border/60 pt-3 md:min-w-72 md:border-l md:border-t-0 md:pl-5 md:pt-0"
            >
              {
                archiveSummary.map((item) => (
                  <div class="min-w-0">
                    <p class="truncate text-lg font-black leading-none tracking-tight text-foreground sm:text-xl">
                      {item.value}
                    </p>
                    <p class="mt-1 text-xs font-medium text-muted-foreground">{item.label}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        {
          allPosts.length > 0 && (
            <nav
              aria-label="归档快速导航"
              class="space-y-3 rounded-xl border border-border/70 bg-card/80 p-3 shadow-sm lg:hidden"
            >
              <div class="flex items-center gap-2 overflow-x-auto pb-0.5">
                <span class="shrink-0 text-xs font-semibold text-muted-foreground">年份</span>
                {groupedPosts.map((yearGroup) => (
                  <a
                    href={`#year-${yearGroup.year}`}
                    class="shrink-0 rounded-full border border-border/70 px-2.5 py-1 text-xs font-medium text-foreground/80 transition-colors hover:border-primary/40 hover:bg-muted hover:text-primary"
                  >
                    {yearGroup.year}
                    <span class="ml-1 text-muted-foreground">{yearGroup.posts.length}</span>
                  </a>
                ))}
              </div>

              {featuredSeries.length > 0 && (
                <div class="flex items-center gap-2 overflow-x-auto border-t border-border/60 pt-3">
                  <a
                    href="/series/"
                    class="shrink-0 text-xs font-semibold text-muted-foreground transition-colors hover:text-primary"
                  >
                    专栏
                  </a>
                  {featuredSeries.map((series) => (
                    <a
                      href={getSeriesPath(series.id)}
                      class="shrink-0 rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-foreground/80 transition-colors hover:bg-primary hover:text-primary-foreground"
                    >
                      {series.data.name}
                    </a>
                  ))}
                </div>
              )}
            </nav>
          )
        }

        {
          allPosts.length === 0 ? (
            <EmptyState type="post" class="w-full" />
          ) : (
            <div class="space-y-8 rounded-xl border border-border/70 bg-card/80 p-4 shadow-sm sm:p-5">
              {groupedPosts.map((yearGroup) => (
                <section id={`year-${yearGroup.year}`} class="scroll-mt-24">
                  <div class="grid grid-cols-[4.25rem_1.25rem_minmax(0,1fr)] items-center gap-2.5 sm:grid-cols-[5rem_1.5rem_minmax(0,1fr)] sm:gap-3">
                    <h2 class="border-l-2 border-foreground pl-2 text-2xl font-black tracking-tight text-foreground sm:text-3xl">
                      {yearGroup.year}
                    </h2>
                    <div class="flex justify-center">
                      <span class="h-2.5 w-2.5 rounded-full border-2 border-primary bg-background" />
                    </div>
                    <p class="text-sm text-muted-foreground sm:text-base">
                      {yearGroup.posts.length} 篇文章
                    </p>
                  </div>

                  <div class="mt-2">
                    {yearGroup.posts.map((post, postIndex) => (
                      <article class="group/archive-row relative grid grid-cols-[4.25rem_1.25rem_minmax(0,1fr)] gap-2.5 rounded-lg transition-colors hover:bg-accent/70 sm:grid-cols-[5rem_1.5rem_minmax(0,1fr)] sm:gap-3">
                        <time
                          datetime={post.data.pubDate.toISOString()}
                          class="relative z-10 py-2.5 text-right font-mono text-xs text-muted-foreground transition-colors group-hover/archive-row:text-foreground sm:text-sm"
                        >
                          {formatShortDate(post.data.pubDate)}
                        </time>

                        <div class="relative flex justify-center">
                          <span
                            class:list={[
                              'absolute top-0 bottom-0 border-l border-dashed border-border transition-colors group-hover/archive-row:border-primary/50',
                              postIndex === yearGroup.posts.length - 1 ? 'h-3' : '',
                            ]}
                          />
                          <span class="relative mt-[0.95rem] h-1.5 w-1.5 rounded-full bg-muted-foreground ring-[3px] ring-background transition-colors group-hover/archive-row:bg-primary group-hover/archive-row:ring-accent" />
                        </div>

                        <a
                          href={getBlogPostPath(post)}
                          class="relative z-10 grid min-w-0 gap-1.5 py-2.5 pr-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-3"
                        >
                          <h3 class="min-w-0 break-words text-base font-bold leading-snug tracking-tight text-foreground transition-colors group-hover/archive-row:text-primary sm:text-[1.05rem]">
                            {post.data.title}
                          </h3>

                          {(() => {
                            const series = getPostSeries(allSeries, post);
                            const label = series
                              ? `专栏 · ${series.data.name}`
                              : post.data.category
                                ? categoryMap.get(post.data.category) || post.data.category
                                : undefined;

                            return (
                              label && (
                                <span class="truncate text-xs text-muted-foreground/75 transition-colors group-hover/archive-row:text-foreground/75 sm:max-w-44 sm:text-right">
                                  {label}
                                </span>
                              )
                            );
                          })()}
                        </a>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          )
        }
      </div>

      <div class="hidden lg:block lg:col-span-4 pl-4">
        <div class="sticky top-24 space-y-4">
          <Sidebar tags={topTags} categories={topCategories} />

          {
            featuredSeries.length > 0 && (
              <aside class="rounded-xl border border-border/50 bg-card p-3 shadow-sm">
                <div class="mb-2 flex items-center justify-between gap-3">
                  <h2 class="flex items-center gap-2 text-base font-bold text-foreground">
                    <span class="h-4 w-1 rounded-full bg-primary" />
                    精选专栏
                  </h2>
                  <a
                    href="/series/"
                    class="text-xs text-muted-foreground transition-colors hover:text-primary"
                  >
                    查看全部 →
                  </a>
                </div>

                <ul class="space-y-1">
                  {featuredSeries.map((series) => (
                    <li>
                      <a
                        href={getSeriesPath(series.id)}
                        class="group block rounded-lg px-2 py-2 transition-colors hover:bg-muted/60"
                      >
                        <div class="flex items-start justify-between gap-3">
                          <span class="min-w-0 font-medium leading-snug text-foreground/85 transition-colors group-hover:text-primary">
                            {series.data.name}
                          </span>
                          <span class="shrink-0 rounded-full border border-border/70 px-1.5 py-0.5 text-[0.65rem] text-muted-foreground">
                            {getSeriesStatusLabel(series.data.status)}
                          </span>
                        </div>
                        <p class="mt-1 line-clamp-2 text-xs leading-5 text-muted-foreground">
                          {series.data.description}
                        </p>
                        <p class="mt-1 text-[0.7rem] text-muted-foreground/70">
                          {seriesPostCounts.get(series.id) || 0} 篇
                        </p>
                      </a>
                    </li>
                  ))}
                </ul>
              </aside>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
