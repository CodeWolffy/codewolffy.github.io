---
export const prerender = true;

import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, Clock3 } from 'lucide-react';

import EmptyState from '@/components/ui/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSeriesPath } from '@/utils/content-paths';
import { createSeriesSummaries, getPublicBlogPosts } from '@/utils/posts';
import { getSiteSettings } from '@/utils/site-settings';

const settings = await getSiteSettings();
const seriesUi = settings.ui.series;
const allPosts = await getPublicBlogPosts();
const allSeries = await getCollection('series');
const seriesSummaries = createSeriesSummaries(allSeries, allPosts);
const totalSeriesPosts = seriesSummaries.reduce((total, item) => total + item.postCount, 0);

const statusLabel = {
  ongoing: '连载中',
  completed: '已完结',
} as const;

const formatDate = (date?: Date) =>
  date
    ? date.toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      })
    : '暂无更新';
---

<BaseLayout title={`${seriesUi.title} | ${settings.name}`} description={seriesUi.description}>
  <section class="container mx-auto pt-0 pb-8">
    <div class="space-y-4">
      <section class="rounded-xl border border-border/70 bg-card/80 px-4 py-5 shadow-sm sm:px-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div class="space-y-2">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">
              {seriesUi.eyebrow}
            </p>
            <div class="space-y-1.5">
              <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
                {seriesUi.title}
              </h1>
              <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
                {seriesUi.description}
              </p>
            </div>
          </div>

          <div
            class="flex shrink-0 items-center gap-5 border-t border-border/60 pt-3 sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0"
          >
            <div>
              <p class="text-xl font-black leading-none text-foreground">
                {seriesSummaries.length}
              </p>
              <p class="mt-1.5 text-xs text-muted-foreground">个专栏</p>
            </div>
            <div>
              <p class="text-xl font-black leading-none text-foreground">{totalSeriesPosts}</p>
              <p class="mt-1.5 text-xs text-muted-foreground">篇文章</p>
            </div>
          </div>
        </div>
      </section>

      {
        seriesSummaries.length === 0 ? (
          <EmptyState
            type="post"
            title="暂无专栏"
            description="专题内容正在整理中，之后会在这里按阅读顺序持续更新。"
            class="w-full"
          />
        ) : (
          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {seriesSummaries.map((summary) => {
              const { series, postCount, latestUpdate } = summary;

              return (
                <article class="group relative flex min-w-0 flex-col overflow-hidden rounded-xl border border-border/70 bg-card/80 shadow-sm transition-colors hover:border-foreground/25">
                  {series.data.coverImage && (
                    <div class="aspect-[16/7] overflow-hidden border-b border-border/60 bg-muted">
                      <img
                        src={series.data.coverImage}
                        alt={`${series.data.name}专栏封面`}
                        width={960}
                        height={420}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                      />
                    </div>
                  )}

                  <div class="flex flex-1 flex-col p-4 sm:p-5">
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-border/70 px-2 py-1 font-medium text-foreground">
                        <span
                          class:list={[
                            'h-1.5 w-1.5 rounded-full',
                            series.data.status === 'ongoing'
                              ? 'bg-foreground'
                              : 'bg-muted-foreground/50',
                          ]}
                        />
                        {statusLabel[series.data.status]}
                      </span>
                      <span class="inline-flex items-center gap-1.5">
                        <BookOpen aria-hidden="true" className="h-3.5 w-3.5" />
                        {postCount} 篇
                      </span>
                    </div>

                    <div class="mt-4 flex-1">
                      <h2 class="break-words text-xl font-black tracking-tight text-foreground transition-colors group-hover:text-primary">
                        {series.data.name}
                      </h2>
                      <p class="mt-2 line-clamp-3 text-sm leading-6 text-muted-foreground">
                        {series.data.description}
                      </p>
                    </div>

                    <div class="mt-5 flex items-center justify-between gap-3 border-t border-border/60 pt-3 text-xs text-muted-foreground">
                      <span class="inline-flex min-w-0 items-center gap-1.5">
                        <Clock3 aria-hidden="true" className="h-3.5 w-3.5 shrink-0" />
                        <span class="truncate">最近更新 {formatDate(latestUpdate)}</span>
                      </span>
                      <ArrowRight
                        aria-hidden="true"
                        className="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-0.5"
                      />
                    </div>
                  </div>

                  <a
                    href={getSeriesPath(series)}
                    class="absolute inset-0 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                  >
                    <span class="sr-only">查看专栏：{series.data.name}</span>
                  </a>
                </article>
              );
            })}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
