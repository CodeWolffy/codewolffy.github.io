---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getPublicBlogPostsSorted, createTaxonomyNameMap } from '@/utils/posts';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getPublicBlogPostsSorted();
  const allCategories = await getCollection('categories');
  const categoryMap = createTaxonomyNameMap(allCategories);

  // Get unique categories from posts
  const uniqueCategories = [...new Set(allPosts.map((post) => post.data.category).filter(Boolean))];

  return uniqueCategories.map((categoryId) => {
    const filteredPosts = allPosts.filter((post) => post.data.category === categoryId);
    const categoryName = categoryMap.get(categoryId) || categoryId;
    return {
      params: { category: categoryId },
      props: { posts: filteredPosts, categoryName },
    };
  });
}

const { posts, categoryName } = Astro.props;

// Get tags for the card labels
const allTags = await getCollection('tags');
const tagMap = createTaxonomyNameMap(allTags);
---

<BaseLayout title={`分类: ${categoryName}`}>
  <section class="container mx-auto pt-0 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8">
      <div class="lg:col-span-12 space-y-4">
        <section class="rounded-xl border border-border/70 bg-card/80 px-4 py-5 shadow-sm sm:px-5">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">
            Category
          </p>
          <div class="mt-2 space-y-1.5">
            <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
              分类: <span class="text-primary">{categoryName}</span>
            </h1>
            <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
              共 {posts.length} 篇相关文章。
            </p>
          </div>
        </section>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            posts.map((post, index) => (
              <PostCard
                post={post}
                index={index}
                mainTagLabel={
                  post.data.tags && post.data.tags.length > 0
                    ? tagMap.get(post.data.tags[0]) || post.data.tags[0]
                    : undefined
                }
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
