---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '@/components/blog/PostCard.astro';
import { Breadcrumbs } from '@/components/ui/Breadcrumbs';
import {
  createTaxonomyNameMap,
  getDedupedMainTagLabel,
  getPostSeriesMap,
  getPublicBlogPostsSorted,
} from '@/utils/posts';
import { getReadingTimeMinutes } from '@/utils/reading-time';
import { getTaxonomyDescription, isIndexableTag } from '@/utils/seo';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getPublicBlogPostsSorted();
  const allTags = await getCollection('tags');
  const tagMap = createTaxonomyNameMap(allTags);

  // Get unique tags from all posts
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

  return uniqueTags.map((tagId) => {
    // Filter posts that include this tag string
    const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tagId));
    const tagName = tagMap.get(tagId) || tagId;
    return {
      params: { tag: tagId },
      props: { posts: filteredPosts, tagName },
    };
  });
}

const { posts, tagName } = Astro.props;

const [allCategories, allTags, allSeries] = await Promise.all([
  getCollection('categories'),
  getCollection('tags'),
  getCollection('series'),
]);
const categoryMap = createTaxonomyNameMap(allCategories);
const tagMap = createTaxonomyNameMap(allTags);
const seriesByPostId = getPostSeriesMap(allSeries);
---

<BaseLayout
  title={`包含标签 #${tagName} 的文章`}
  description={getTaxonomyDescription(
    tagName,
    posts.map((post) => post.data.title)
  )}
  robots={isIndexableTag(posts.length) ? undefined : 'noindex,follow'}
>
  <section class="container mx-auto pt-0 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8">
      <div class="lg:col-span-12 space-y-4">
        <Breadcrumbs items={[{ label: '标签', href: '/tags/' }, { label: tagName }]} />
        <section class="rounded-xl border border-border/70 bg-card/80 px-4 py-5 shadow-sm sm:px-5">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Tag</p>
          <div class="mt-2 space-y-1.5">
            <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
              标签: <span class="text-primary">#{tagName}</span>
            </h1>
            <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
              共 {posts.length} 篇相关文章。
            </p>
          </div>
        </section>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, index) => {
            const seriesLabel = seriesByPostId.get(post.id)?.data.name;
            const categoryLabel = post.data.category
              ? categoryMap.get(post.data.category) || post.data.category
              : undefined;
            const mainTagLabel = getDedupedMainTagLabel(
              post.data.tags,
              tagMap,
              seriesLabel || categoryLabel,
              tagName
            );

            return (
              <PostCard
                post={post}
                index={index}
                seriesLabel={seriesLabel}
                categoryLabel={categoryLabel}
                mainTagLabel={mainTagLabel}
                readingTime={getReadingTimeMinutes(post.body || '')}
              />
            );
          })}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
