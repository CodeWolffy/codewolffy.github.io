---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '@/components/blog/PostCard.astro';
import { Breadcrumbs } from '@/components/ui/Breadcrumbs';
import { createTaxonomyNameMap, getPublicBlogPostsSorted } from '@/utils/posts';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getPublicBlogPostsSorted();
  const allTags = await getCollection('tags');
  const tagMap = createTaxonomyNameMap(allTags);

  // Get unique tags from all posts
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

  return uniqueTags.map((tagId) => {
    // Filter posts that include this tag string
    const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tagId));
    const tagName = tagMap.get(tagId) || tagId;
    return {
      params: { tag: tagId },
      props: { posts: filteredPosts, tagName },
    };
  });
}

const { posts, tagName } = Astro.props;

// Get tags for the card labels
const allTags = await getCollection('tags');
const tagMap = createTaxonomyNameMap(allTags);
---

<BaseLayout title={`包含标签 #${tagName} 的文章`}>
  <section class="container mx-auto pt-0 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8">
      <div class="lg:col-span-12 space-y-4">
        <Breadcrumbs items={[{ label: '标签', href: '/tags/' }, { label: tagName }]} />
        <section class="rounded-xl border border-border/70 bg-card/80 px-4 py-5 shadow-sm sm:px-5">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Tag</p>
          <div class="mt-2 space-y-1.5">
            <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
              标签: <span class="text-primary">#{tagName}</span>
            </h1>
            <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
              共 {posts.length} 篇相关文章。
            </p>
          </div>
        </section>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            posts.map((post, index) => (
              <PostCard
                post={post}
                index={index}
                mainTagLabel={
                  post.data.tags && post.data.tags.length > 0
                    ? tagMap.get(post.data.tags[0]) || post.data.tags[0]
                    : undefined
                }
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
