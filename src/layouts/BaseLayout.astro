---
import { ClientRouter } from 'astro:transitions'; // Using ClientRouter for ViewTransitions in modern Astro
import { getCollection } from 'astro:content';
import { Header } from '@/components/layout/Header';
import { FloatingMusicPlayer } from '@/components/music/FloatingMusicPlayer';
import ScrollToTop from '@/components/ui/ScrollToTop.astro';
import { getIconComponent } from '@/lib/icons';
import { getSeriesPath } from '@/utils/content-paths';
import { getMusicTracks } from '@/utils/music-tracks';
import { createSeriesSummaries, getPublicBlogPostsSorted } from '@/utils/posts';
import { getSiteSettings } from '@/utils/site-settings';
import { getCanonicalUrl, serializeJsonLd } from '@/utils/seo';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  robots?: string;
  canonical?: boolean;
  preconnectGiscus?: boolean;
}

const settings = await getSiteSettings();

const {
  title,
  description = settings.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = settings.author.name,
  robots,
  canonical = true,
  preconnectGiscus = false,
} = Astro.props;

// 构建完整的 OG 图片 URL
const ogImage = image
  ? new URL(image, settings.urls.primary)
  : new URL(settings.og.defaultImage, settings.urls.primary);
const canonicalUrl = getCanonicalUrl(Astro.url.pathname, settings.urls.primary);
const busuanzi = settings.analytics.busuanzi;
const busuanziClientConfig = serializeJsonLd(busuanzi);
const socialIconByLabel = {
  Bilibili: 'bilibili',
  Douyin: 'douyin',
  Instagram: 'instagram',
  GitHub: 'github',
  Juejin: 'juejin',
  RSS: 'rss',
} as const;
const footerSocials = settings.socials
  .map((item) => ({
    ...item,
    icon: socialIconByLabel[item.label as keyof typeof socialIconByLabel],
  }))
  .filter((item): item is typeof item & { icon: string } => Boolean(item.icon));
const musicTracks = await getMusicTracks();
const [allSeries, publicPosts] = await Promise.all([
  getCollection('series'),
  getPublicBlogPostsSorted(),
]);
const footerSeries = createSeriesSummaries(allSeries, publicPosts)
  .filter((summary) => summary.postCount > 0)
  .slice(0, 4);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    {/* 无闪烁主题：在首屏绘制前同步应用 .dark，避免深色用户看到浅色闪烁 */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const isDark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', isDark);
        } catch {
          /* localStorage 不可用时忽略 */
        }
      })();
    </script>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icon-192x192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={settings.rss.title}
      href={new URL(settings.links.rss, settings.urls.primary)}
    />
    {busuanzi.enabled && (
      <>
        {/* 不蒜子预连接优化 */}
        <link rel="dns-prefetch" href={busuanzi.origin} />
        <link rel="preconnect" href={busuanzi.origin} crossorigin />
      </>
    )}
    {preconnectGiscus && settings.comments.giscus.enabled && (
      <>
        <link rel="dns-prefetch" href="https://giscus.app" />
        <link rel="preconnect" href="https://giscus.app" crossorigin />
      </>
    )}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {settings.verification.google.map((token) => (
      <meta name="google-site-verification" content={token} />
    ))}

    <!-- Canonical URL -->
    {canonical && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:locale" content={settings.og.locale} />

    {/* Article 扩展标签 - 仅用于文章页 */}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />

    {/* Theme Initialization Script to prevent FOUC */}
    <script is:inline type="module" src="/theme.js"></script>
    {busuanzi.enabled && (
      <script
        is:inline
        set:html={`
(() => {
  const config = ${busuanziClientConfig};
  const stateKey = '__busuanziPageviewLoader';
  const state = (window[stateKey] ||= {
    installed: false,
    timer: 0,
    observer: null,
    lastUrl: '',
    lastAt: 0,
  });

  const disconnectObserver = () => {
    if (state.observer) {
      state.observer.disconnect();
      state.observer = null;
    }
  };

  const hideCounter = (container) => {
    disconnectObserver();
    window.clearTimeout(state.timer);
    if (!container) return;
    container.setAttribute('data-pv-state', 'hidden');
    container.style.display = 'none';
    container.setAttribute('aria-hidden', 'true');
  };

  const resetCounter = (container, value) => {
    value.textContent = '';
    value.setAttribute('aria-label', '正在加载浏览量');
    container.setAttribute('data-pv-state', 'loading');
    container.style.display = 'inline-flex';
    container.removeAttribute('aria-hidden');
  };

  const syncCounterReady = (container, value) => {
    const text = value?.textContent?.trim();
    if (!text) return false;
    container.setAttribute('data-pv-state', 'ready');
    value.removeAttribute('aria-label');
    window.clearTimeout(state.timer);
    disconnectObserver();
    return true;
  };

  const loadCounter = () => {
    const container = document.getElementById(config.pagePvContainerId);
    const value = document.getElementById(config.pagePvValueId);
    if (!container || !value) return;

    const now = Date.now();
    const currentUrl = window.location.href;
    if (state.lastUrl === currentUrl && now - state.lastAt < 2000) return;
    state.lastUrl = currentUrl;
    state.lastAt = now;

    disconnectObserver();
    resetCounter(container, value);
    window.clearTimeout(state.timer);

    state.observer = new MutationObserver(() => {
      syncCounterReady(container, value);
    });
    state.observer.observe(value, { childList: true, characterData: true, subtree: true });

    document.getElementById(config.scriptId)?.remove();

    const script = document.createElement('script');
    script.id = config.scriptId;
    script.src = config.scriptSrc;
    script.async = true;
    script.defer = true;
    script.referrerPolicy = 'no-referrer-when-downgrade';
    script.onload = () => {
      syncCounterReady(container, value);
    };
    script.onerror = () => hideCounter(container);

    state.timer = window.setTimeout(() => {
      const latestContainer = document.getElementById(config.pagePvContainerId);
      const latestValue = document.getElementById(config.pagePvValueId);
      if (!syncCounterReady(latestContainer, latestValue)) {
        hideCounter(latestContainer);
      }
    }, Number(config.timeoutMs) || 5000);

    document.head.appendChild(script);
  };

  if (!state.installed) {
    state.installed = true;
    document.addEventListener('astro:before-swap', () => {
      window.clearTimeout(state.timer);
      disconnectObserver();
    });
    document.addEventListener('astro:page-load', loadCounter);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadCounter, { once: true });
  } else {
    loadCounter();
  }
})();
          `}
      />
    )}
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <!-- 跳过导航链接 - 改进可访问性 -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md focus:outline-none"
    >
      跳过导航
    </a>
    <div class="relative flex min-h-screen flex-col">
      <Header
        client:load
        transition:persist
        name={settings.name}
        navigation={settings.navigation}
        githubUrl={settings.links.github}
      />
      <main id="main-content" class="page-enter flex-1 pb-10">
        <slot />
      </main>

      <footer class="mt-auto border-t border-border/70 bg-card/40 relative z-10">
        <div class="container mx-auto py-8 sm:py-10">
          <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-8 lg:gap-10 md:items-start">
            <div class="space-y-3.5 md:col-span-5">
              <div class="flex flex-wrap items-center gap-2.5">
                <a
                  href="/"
                  class="text-xl font-bold tracking-tight text-foreground hover:text-primary transition-colors"
                >
                  {settings.name}
                </a>
                <span class="text-xs font-medium px-2.5 py-0.5 rounded-full border border-border/80 text-muted-foreground">
                  {settings.ui.home.taglineFallback}
                </span>
              </div>
              <p class="max-w-md text-sm sm:text-[15px] leading-relaxed text-muted-foreground">
                {settings.ui.home.focusLine || settings.description}
              </p>
              <div class="flex items-center gap-4 pt-1">
                {footerSocials.map((item) => {
                  const Icon = getIconComponent(item.icon);
                  const external = !item.href.startsWith('/');

                  return (
                    <a
                      href={item.href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      class="text-muted-foreground hover:text-primary transition-colors"
                    >
                      <span class="sr-only">{item.label}</span>
                      <Icon aria-hidden="true" width={22} height={22} />
                    </a>
                  );
                })}
              </div>
            </div>

            <div
              class:list={[
                'grid grid-cols-2 gap-8 md:col-span-7',
                footerSeries.length > 0 ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
              ]}
            >
              {footerSeries.length > 0 && (
                <nav aria-label="页脚精选专栏" class="col-span-2 sm:col-span-1 space-y-3">
                  <h2 class="text-sm font-semibold tracking-wide text-foreground/90">精选专栏</h2>
                  <ul class="space-y-2 text-sm sm:text-[15px] text-muted-foreground">
                    {footerSeries.map((summary) => (
                      <li>
                        <a
                          href={getSeriesPath(summary.series.id)}
                          class="hover:text-primary transition-colors line-clamp-1"
                        >
                          {summary.series.data.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}

              <nav aria-label="页脚内容导航" class="space-y-3">
                <h2 class="text-sm font-semibold tracking-wide text-foreground/90">内容导航</h2>
                <ul class="space-y-2 text-sm sm:text-[15px] text-muted-foreground">
                  <li>
                    <a href="/series/" class="hover:text-primary transition-colors">
                      系统专栏
                    </a>
                  </li>
                  <li>
                    <a href="/archives/" class="hover:text-primary transition-colors">
                      写作归档
                    </a>
                  </li>
                  <li>
                    <a href="/categories/" class="hover:text-primary transition-colors">
                      分类与标签
                    </a>
                  </li>
                  <li>
                    <a href="/tags/" class="hover:text-primary transition-colors">
                      全部标签
                    </a>
                  </li>
                </ul>
              </nav>

              <nav aria-label="页脚站点与订阅" class="space-y-3">
                <h2 class="text-sm font-semibold tracking-wide text-foreground/90">站点与订阅</h2>
                <ul class="space-y-2 text-sm sm:text-[15px] text-muted-foreground">
                  <li>
                    <a href="/projects/" class="hover:text-primary transition-colors">
                      项目展示
                    </a>
                  </li>
                  <li>
                    <a href="/friends/" class="hover:text-primary transition-colors">
                      友情链接
                    </a>
                  </li>
                  <li>
                    <a href="/about/" class="hover:text-primary transition-colors">
                      关于我
                    </a>
                  </li>
                  <li>
                    <a href={settings.links.rss} class="hover:text-primary transition-colors">
                      RSS 订阅
                    </a>
                  </li>
                </ul>
              </nav>
            </div>
          </div>

          <div class="mt-7 border-t border-border/60 pt-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs sm:text-sm text-muted-foreground">
            <p>
              © {new Date().getFullYear()} {settings.name}. {settings.ui.footer.rights}
            </p>
            <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-muted-foreground/80">
              <a href="/sitemap-index.xml" class="hover:text-primary transition-colors">
                站点地图
              </a>
              <span aria-hidden="true">·</span>
              <span>Built with Astro</span>
              <span aria-hidden="true">·</span>
              <span>Content by Keystatic</span>
            </p>
          </div>
        </div>
      </footer>

      <!-- 滚动到顶部按钮 -->
      <ScrollToTop />
      {musicTracks.length > 0 && (
        <FloatingMusicPlayer client:load transition:persist tracks={musicTracks} />
      )}
    </div>
  </body>
</html>
